# Base principale
DATABASE_URL=postgresql+psycopg://scanner:scanner@localhost:5432/sts_navio_db
# Base de test (utilisée par pytest : TEST_DATABASE_URL=...). Elle est VIDÉE avant chaque test.
TEST_DATABASE_URL=postgresql+psycopg://scanner:scanner@localhost:5432/test_navio_db
LOG_LEVEL=INFO
# Fenetre (minutes) pour considerer deux scans comme le meme voyage
TRIP_WINDOW_MINUTES=60
# Fuseau horaire pour determiner la date du scan (choix du tarif, validite des abonnements)
BUSINESS_TIMEZONE=Africa/Tunis

# API TEMPORAIRE de réinitialisation des données de test (POST /api/v1/test-data/reset)
TEST_DATA_RESET_ENABLED=true
# Si défini : l'appel doit envoyer l'en-tête X-Reset-Token (à définir si le serveur est joignable depuis Internet)
# TEST_DATA_RESET_TOKEN=
